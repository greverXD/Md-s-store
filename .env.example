# ── Фронтенд (Vite). Эти ключи публичные, их можно показывать в браузере ──
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Cloudflare Turnstile → Site Key (публичный)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ── Сервер (только в Vercel → Settings → Environment Variables, НЕ в браузер) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # секретный! никогда не коммитить

# ── Секреты Edge Functions (supabase secrets set ...), здесь только для справки ──
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# SITE_URL=https://your-site.ru
